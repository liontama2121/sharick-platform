{
  "moduleId": 1,
  "title": "Greetings and Introductions",
  "topics": [
    {
      "id": "t1",
      "title": "Greetings (formal & informal)",
      "summary": "Hello, Hi, Hey and What's up? — and when to use each one.",
      "learn": [
        {
          "type": "text",
          "text": "In English, the greeting changes with the situation. With a teacher, a boss or someone you don't know, use a FORMAL greeting. With friends and family, use an INFORMAL one."
        },
        {
          "type": "phrases",
          "title": "Key phrases",
          "items": [
            { "en": "Hello!", "es": "¡Hola!", "note": "formal or neutral" },
            { "en": "Good morning, Ms. Prieto.", "es": "Buenos días, señora Prieto.", "note": "formal" },
            { "en": "Hi!", "es": "¡Hola!", "note": "informal, very common" },
            { "en": "Hey!", "es": "¡Ey! / ¡Hola!", "note": "informal, friends only" },
            { "en": "What's up?", "es": "¿Qué más? / ¿Qué hay?", "note": "informal question" },
            { "en": "Not much.", "es": "Nada nuevo.", "note": "answer to What's up?" }
          ]
        },
        {
          "type": "dialogue",
          "letter": "A",
          "title": "Formal — at the bank in Bogotá",
          "lines": [
            { "speaker": "Camila", "text": "Good morning. Hello, Mr. Rojas." },
            { "speaker": "Mr. Rojas", "text": "Good morning, Camila. How can I help you?" }
          ]
        },
        {
          "type": "dialogue",
          "letter": "B",
          "title": "Informal — at the beach in Cartagena",
          "lines": [
            { "speaker": "Diego", "text": "Hey, Valentina! What's up?" },
            { "speaker": "Valentina", "text": "Hi, Diego. Not much. And you?" }
          ]
        },
        {
          "type": "tip",
          "title": "Cultural tip",
          "text": "In Colombia, Venezuela, Bolivia and Panama people often add a question to the greeting: ¿bien o qué?, ¿qué más?, ¿cómo va? In English, \"What's up?\" or \"How's it going?\" does the same job."
        }
      ],
      "exercises": [
        {
          "type": "multipleChoice",
          "q": "You meet your teacher in the morning. What do you say?",
          "options": ["Hey, what's up?", "Good morning, teacher.", "Not much."],
          "correct": 1
        },
        {
          "type": "multipleChoice",
          "q": "Your friend says \"What's up?\". You answer…",
          "options": ["Not much. And you?", "Good morning.", "It's a pleasure."],
          "correct": 0
        },
        {
          "type": "multipleChoice",
          "q": "Which greeting is INFORMAL?",
          "options": ["Good afternoon, sir.", "Hello, Mrs. Díaz.", "Hey!"],
          "correct": 2
        },
        {
          "type": "fillIn",
          "sentence": "___ morning, Mr. Rojas.",
          "answer": "Good",
          "hint": "formal"
        },
        {
          "type": "fillIn",
          "sentence": "Hey, Lucía! What's ___?",
          "answer": "up"
        },
        {
          "type": "match",
          "pairs": [
            ["Hello!", "¡Hola! (formal)"],
            ["What's up?", "¿Qué más?"],
            ["Not much.", "Nada nuevo."],
            ["Good morning.", "Buenos días."]
          ]
        },
        {
          "type": "scramble",
          "answer": "Good morning Ms Prieto",
          "hint": "A formal greeting to your teacher"
        }
