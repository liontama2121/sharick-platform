    {
      "id": "t2",
      "title": "Introducing yourself",
      "summary": "I'm… / My name is… / Nice to meet you — and how to answer.",
      "learn": [
        {
          "type": "text",
          "text": "To introduce yourself, say your name and, if you want, where you are from. Then the other person answers with \"Nice to meet you\" and you reply \"Nice to meet you too\"."
        },
        {
          "type": "phrases",
          "title": "Key phrases",
          "items": [
            { "en": "I'm Camila.", "es": "Soy Camila.", "note": "short and common" },
            { "en": "My name is Mateo.", "es": "Me llamo Mateo.", "note": "a bit more formal" },
            { "en": "I'm from La Paz.", "es": "Soy de La Paz.", "note": "your city or country" },
            { "en": "Nice to meet you.", "es": "Mucho gusto.", "note": "" },
            { "en": "It's a pleasure to meet you.", "es": "Es un placer conocerte.", "note": "formal" },
            { "en": "Nice to meet you too.", "es": "Igualmente.", "note": "the answer" }
          ]
        },
        {
          "type": "dialogue",
          "letter": "A",
          "title": "Two students meet in Medellín",
          "lines": [
            { "speaker": "Camila", "text": "Hi! I'm Camila." },
            { "speaker": "Mateo", "text": "Hey, Camila. I'm Mateo." },
            { "speaker": "Camila", "text": "It's a pleasure to meet you, Mateo." },
            { "speaker": "Mateo", "text": "Nice to meet you too." }
          ]
        },
        {
          "type": "dialogue",
          "letter": "B",
          "title": "At a conference in Panama City",
          "lines": [
            { "speaker": "Andrés", "text": "Good morning. My name is Andrés Paredes. I'm from Bolivia." },
            { "speaker": "Sofía", "text": "Nice to meet you, Andrés. I'm Sofía, from Panama." }
          ]
        },
        {
          "type": "tip",
          "title": "Grammar note",
          "text": "I'm = I am. My name is + name. Don't say \"I'm call Camila\" — say \"I'm Camila\" or \"My name is Camila\"."
        }
      ],
      "exercises": [
