    {
      "id": "t3",
      "title": "Introducing others",
      "summary": "This is my friend… — presenting a friend to someone else.",
      "learn": [
        {
          "type": "text",
          "text": "When you introduce another person, use \"This is…\" + who they are. Then the two people greet each other."
        },
        {
          "type": "phrases",
          "title": "Key phrases",
          "items": [
            { "en": "This is my friend Lucía.", "es": "Ella es mi amiga Lucía.", "note": "" },
            { "en": "Lucía, this is Diego.", "es": "Lucía, él es Diego.", "note": "name first" },
            { "en": "This is my teacher, Ms. Prieto.", "es": "Ella es mi profesora, la señora Prieto.", "note": "formal" },
            { "en": "Great to meet you.", "es": "Un gusto conocerte.", "note": "friendly" },
            { "en": "Nice to meet you too.", "es": "Igualmente.", "note": "" }
          ]
        },
        {
          "type": "dialogue",
          "letter": "B",
          "title": "Valentina introduces Lucía",
          "lines": [
            { "speaker": "Valentina", "text": "Hello, Diego. What's up?" },
            { "speaker": "Diego", "text": "Not much. And you?" },
            { "speaker": "Valentina", "text": "I'm good. This is my friend Lucía. Lucía, this is Diego." },
            { "speaker": "Diego", "text": "Hi, Lucía. Great to meet you." },
            { "speaker": "Lucía", "text": "Hi, Diego. Nice to meet you too." }
          ]
        },
        {
          "type": "tip",
          "title": "Cultural tip",
          "text": "How do you say \"friend\"? parcero (Colombia) · pana (Venezuela) · ñaño or colega (Bolivia) · fren (Panama). In English: friend, buddy or mate."
        }
      ],
