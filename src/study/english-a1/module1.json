    {
      "id": "t4",
      "title": "Saying goodbye",
      "summary": "Bye, Take care, See you soon — ways to end a conversation.",
      "learn": [
        {
          "type": "text",
          "text": "There are many ways to say goodbye. \"Goodbye\" is neutral; \"Bye\" is short and friendly; \"See you…\" tells WHEN you will meet again; \"Take care\" is a warm wish."
        },
        {
          "type": "phrases",
          "title": "Key phrases",
          "items": [
            { "en": "Goodbye.", "es": "Adiós.", "note": "neutral" },
            { "en": "Bye!", "es": "¡Chao!", "note": "informal" },
            { "en": "See you soon!", "es": "¡Hasta pronto!", "note": "" },
            { "en": "See you later.", "es": "Hasta luego.", "note": "" },
            { "en": "See you tomorrow.", "es": "Hasta mañana.", "note": "" },
            { "en": "Take care!", "es": "¡Cuídate!", "note": "warm" },
            { "en": "Have a nice day!", "es": "¡Que tengas un buen día!", "note": "polite" }
          ]
        },
        {
          "type": "dialogue",
          "letter": "C",
          "title": "Sofía and Andrés say goodbye",
          "lines": [
            { "speaker": "Sofía", "text": "Goodbye, Andrés." },
            { "speaker": "Andrés", "text": "Bye, Sofía. Take care!" },
            { "speaker": "Sofía", "text": "See you soon!" }
          ]
        },
        {
          "type": "tip",
          "title": "Watch out",
          "text": "\"Good night\" is a GOODBYE at night (or before sleeping), not a greeting. To greet someone at night, say \"Good evening\"."
        }
      ],
