    {
      "id": "t5",
      "title": "Times of the day",
      "summary": "Good morning / afternoon / evening / night — and the clock.",
      "learn": [
        {
          "type": "text",
          "text": "The greeting depends on the time. Morning is until 12:00. Afternoon goes from 12:00 to about 6:00 p.m. Evening is from about 6:00 p.m. until bedtime. \"Good night\" is only for saying goodbye or going to sleep."
        },
        {
          "type": "phrases",
          "title": "Key phrases",
          "items": [
            { "en": "Good morning", "es": "Buenos días", "note": "until 12:00" },
            { "en": "Good afternoon", "es": "Buenas tardes", "note": "12:00 – 6:00 p.m." },
            { "en": "Good evening", "es": "Buenas noches (saludo)", "note": "after 6:00 p.m." },
            { "en": "Good night", "es": "Buenas noches (despedida)", "note": "goodbye / bedtime" },
            { "en": "noon", "es": "mediodía", "note": "12:00 p.m." },
            { "en": "midnight", "es": "medianoche", "note": "12:00 a.m." }
          ]
        },
        {
          "type": "dialogue",
          "letter": "D",
          "title": "A day in Cali",
          "lines": [
            { "speaker": "7:00 a.m.", "text": "Good morning, grandma!" },
            { "speaker": "12:30 p.m.", "text": "Good afternoon, everyone. Lunch is ready." },
            { "speaker": "7:00 p.m.", "text": "Good evening! I'm home." },
            { "speaker": "9:30 p.m.", "text": "Good night, mom. See you tomorrow." }
          ]
        },
        {
          "type": "tip",
          "title": "Cultural tip",
          "text": "In Colombia, las onces (around 4:00 p.m., coffee with pandebono) are still \"Good afternoon\" time. \"Good evening\" starts when the sun goes down, around six."
        }
      ],
