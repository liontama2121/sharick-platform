          "hideHeader": true,
          "title": "Reading · Dialogues A & B",
          "navTitle": "Reading · Dialogues A & B",
          "sections": [
            {
              "type": "dialogues",
              "id": "dialogues-ab",
              "label": "Reading",
              "items": [
                {
                  "id": "A",
                  "label": "Dialogue A",
                  "context": "Formal · dos profesionales frente a las murallas",
                  "audio": "/audio/english/module1/dialogue-a.mp3",
                  "characters": [
                    "Camila",
                    "Andrés"
                  ],
                  "lines": [
                    {
                      "speaker": "Camila",
                      "text": "Good morning. I'm Camila Restrepo, from the tourism office of Cartagena."
                    },
                    {
                      "speaker": "Andrés",
                      "text": "Good morning, Ms. Restrepo. My name is Andrés Baena. It's a pleasure to meet you."
                    },
                    {
                      "speaker": "Camila",
                      "text": "Nice to meet you too, Mr. Baena. Welcome to the walled city."
                    },
                    {
                      "speaker": "Andrés",
                      "text": "Thank you very much. How are you today?"
                    },
                    {
                      "speaker": "Camila",
                      "text": "I'm very well, thank you. Shall we start the tour?"
                    }
                  ]
                },
                {
                  "id": "B",
                  "label": "Dialogue B",
                  "context": "Informal · dos jóvenes camino a Bocagrande",
                  "audio": "/audio/english/module1/dialogue-b.mp3",
                  "characters": [
                    "Valentina",
                    "Felipe"
                  ],
                  "lines": [
                    {
                      "speaker": "Valentina",
                      "text": "Hey, Felipe! Hi! How are you?"
                    },
                    {
                      "speaker": "Felipe",
                      "text": "Hi, Vale! I'm great, thanks. And you?"
                    },
                    {
                      "speaker": "Valentina",
                      "text": "Pretty good! Are you going to the beach?"
                    },
                    {
                      "speaker": "Felipe",
                      "text": "Yes, my cousins are waiting for me. See you there!"
                    },
                    {
                      "speaker": "Valentina",
                      "text": "See you later, parcero!"
                    }
                  ]
                }
              ]
            }
          ]
        },
