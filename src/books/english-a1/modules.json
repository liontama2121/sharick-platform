                        {
                          "speaker": "Valentina",
                          "text": "Hello, Lucía! Nice to meet you. I'm Valentina."
                        },
                        {
                          "speaker": "Lucía",
                          "text": "Nice to meet you too, Valentina. Where are you from?"
                        },
                        {
                          "speaker": "Valentina",
                          "text": "I'm from Medellín. And Santiago is from Cartagena."
                        },
                        {
                          "speaker": "Lucía",
                          "text": "Latin America is a small world! Thank you for the welcome."
                        }
