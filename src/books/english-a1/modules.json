                  "items": [
                    {
                      "id": "A",
                      "label": "Dialogue A",
                      "context": "Formal · Bogotá y Buenos Aires se conocen en Cartagena",
                      "audio": "/audio/english/module1/dialogue-a.mp3",
                      "characters": [
                        "Camila",
                        "Mateo"
                      ],
                      "lines": [
                        {
                          "speaker": "Camila",
                          "text": "Good morning. I'm Camila Restrepo, from the tourism office of Cartagena."
                        },
                        {
                          "speaker": "Mateo",
                          "text": "Good morning, Ms. Restrepo. My name is Mateo Ferreyra. It's a pleasure to meet you."
                        },
                        {
                          "speaker": "Camila",
                          "text": "Nice to meet you too, Mr. Ferreyra. Where are you from?"
                        },
                        {
                          "speaker": "Mateo",
                          "text": "I'm from Buenos Aires, in Argentina. This is my first time in Colombia."
                        },
                        {
                          "speaker": "Camila",
                          "text": "Welcome! I'm from Bogotá, but I live here now. Shall we start the tour?"
                        }
                      ]
                    },
                    {
                      "id": "B",
                      "label": "Dialogue B",
                      "context": "Informal · Medellín y Ciudad de México camino a la playa",
                      "audio": "/audio/english/module1/dialogue-b.mp3",
                      "characters": [
                        "Valentina",
                        "Diego"
                      ],
                      "lines": [
                        {
                          "speaker": "Valentina",
                          "text": "Hey, Diego! Hi! How are you?"
                        },
                        {
                          "speaker": "Diego",
                          "text": "Hi, Vale! I'm great, thanks. And you?"
                        },
                        {
                          "speaker": "Valentina",
                          "text": "Pretty good! Are you going to the beach?"
                        },
                        {
                          "speaker": "Diego",
                          "text": "Yes! I'm from Mexico City, so the sea is a treat for me."
                        },
                        {
                          "speaker": "Valentina",
                          "text": "Ha! I'm from Medellín, same thing. See you later, amigo!"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
