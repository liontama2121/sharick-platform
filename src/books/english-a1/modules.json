                    {
                      "speaker": "Santiago",
                      "text": "Hello, Juliana! Nice to meet you. I'm Santiago."
                    },
                    {
                      "speaker": "Juliana",
                      "text": "Nice to meet you too, Santiago. Where are you from?"
                    },
                    {
                      "speaker": "Santiago",
                      "text": "I'm from Cartagena. Welcome to my city!"
                    },
                    {
                      "speaker": "Juliana",
                      "text": "Thank you! It's beautiful here."
                    }
                  ]
                }
